[Unit]
Description=OpenPortal aip1.clusters.shared.slurm agent
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
RestartSec=1
User=root
Environment="RUST_LOG_FORMAT=json"
Environment="RUST_LOG=info"
ExecStart=/usr/bin/op-cluster -c /etc/openportal/cluster-config.toml run

[Install]
WantedBy=multi-user.target
